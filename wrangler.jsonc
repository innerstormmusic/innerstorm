{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Must match the Worker's name in the Cloudflare dashboard.
  "name": "innerstorm",
  "compatibility_date": "2026-09-01",
  // Only /api/* and /media/* reach the Worker; everything else is served from the static assets.
  "main": "./worker/index.ts",
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/media/*"]
  },
  "r2_buckets": [
    {
      // The MP3s, in the folders tracks/, mixes/ and calendar/. Read through this binding, so the
      // bucket itself stays private.
      "binding": "MEDIA",
      "bucket_name": "innerstorm-media"
    }
  ]
}
